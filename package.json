{
  "name": "mod2sid",
  "productName": "mod2sid",
  "version": "1.0.0",
  "description": "Amiga MOD → C64 SID + GoatTracker SNG converter with AI sample recognition",
  "author": "IT-DUMMKOPFEN",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/main/main.cjs",
  "homepage": "https://github.com/IT-DUMMKOPFEN/mod2sid",
  "repository": { "type": "git", "url": "https://github.com/IT-DUMMKOPFEN/mod2sid.git" },
  "scripts": {
    "start": "electron .",
    "test": "node tools/test/run_all.mjs test-mods",
    "pack": "electron-builder --mac dir --arm64 --publish never",
    "dist": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.it-dummkopfen.mod2sid",
    "productName": "mod2sid",
    "copyright": "© IT-DUMMKOPFEN – GPL-3.0",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json", "LICENSE"],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "fileAssociations": [{ "ext": ["mod"], "name": "Amiga MOD", "role": "Viewer" }]
    },
    "dmg": { "title": "mod2sid ${version}" }
  }
}
